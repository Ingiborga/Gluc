<+><?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<androidx.constraintlayout.widget.ConstraintLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\r\n    <?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<<androidx.drawerlayout.widget.DrawerLayout\r\nxmlns:android=\"http://schemas.android.com/apk/res/android\"\r\nxmlns:app=\"http://schemas.android.com/apk/res-auto\"\r\nandroid:id=\"@+id/drawer_layout\"\r\nandroid:layout_width=\"match_parent\"\r\nandroid:layout_height=\"match_parent\"\r\nandroid:background=\"#212121\">\r\n\r\n<LinearLayout\r\n    android:layout_width=\"match_parent\"\r\n    android:layout_height=\"match_parent\"\r\n    android:orientation=\"vertical\">\r\n\r\n    <!-- Toolbar -->\r\n    <androidx.appcompat.widget.Toolbar\r\n        android:id=\"@+id/toolbar\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:background=\"?attr/colorPrimary\"\r\n        android:minHeight=\"?attr/actionBarSize\" />\r\n\r\n    <!-- График глюкозы (как в xDrip) -->\r\n    <com.github.mikephil.charting.charts.LineChart\r\n        android:id=\"@+id/chart\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"0dp\"\r\n        android:layout_weight=\"1\"\r\n        android:layout_marginTop=\"8dp\" />\r\n\r\n    <!-- Текущее значение крупным шрифтом -->\r\n    <LinearLayout\r\n        android:layout_width=\"wrap_content\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:orientation=\"horizontal\"\r\n        android:layout_gravity=\"end\"\r\n        android:layout_marginEnd=\"20dp\"\r\n        android:layout_marginBottom=\"4dp\">\r\n\r\n        <TextView\r\n            android:id=\"@+id/currentBgValueRealTime\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:text=\"--.-\"\r\n            android:textSize=\"50sp\"\r\n            android:textStyle=\"bold\"\r\n            android:textColor=\"@android:color/white\" />\r\n\r\n        <ImageView\r\n            android:id=\"@+id/trendArrow\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_marginStart=\"10dp\"\r\n            android:layout_marginTop=\"18dp\"\r\n            android:src=\"@drawable/ic_arrow_forward_color_24dp\" />\r\n    </LinearLayout>\r\n\r\n    <!-- Статусная строка -->\r\n    <TextView\r\n        android:id=\"@+id/extraStatusLine\"\r\n        android:layout_width=\"wrap_content\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:layout_marginStart=\"10dp\"\r\n        android:text=\"Статус сенсора\"\r\n        android:textAppearance=\"?android:attr/textAppearanceSmall\"\r\n        android:shadowColor=\"#ff212121\"\r\n        android:shadowDx=\"0\"\r\n        android:shadowDy=\"0\"\r\n        android:shadowRadius=\"14\" />\r\n\r\n    <!-- Прогноз низкого сахара -->\r\n    <TextView\r\n        android:id=\"@+id/lowpredict\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:layout_marginStart=\"35dp\"\r\n        android:layout_marginEnd=\"30dp\"\r\n        android:text=\"Прогноз: стабильно\"\r\n        android:textColor=\"#C30909\"\r\n        android:textStyle=\"bold\"\r\n        android:shadowColor=\"#ff212121\"\r\n        android:shadowDx=\"0\"\r\n        android:shadowDy=\"0\"\r\n        android:shadowRadius=\"14\" />\r\n\r\n    <!-- Панель быстрых действий -->\r\n    <LinearLayout\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:orientation=\"horizontal\"\r\n        android:gravity=\"center\"\r\n        android:padding=\"8dp\">\r\n\r\n        <ImageButton\r\n            android:id=\"@+id/btnTreatment\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:background=\"@android:color/transparent\"\r\n            android:src=\"@drawable/ic_eyedropper_variant_grey600_24dp\"\r\n            android:contentDescription=\"Лечение\" />\r\n\r\n        <ImageButton\r\n            android:id=\"@+id/btnNote\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:background=\"@android:color/transparent\"\r\n            android:src=\"@drawable/ic_note_plus_grey600_24dp\"\r\n            android:contentDescription=\"Заметка\" />\r\n\r\n        <ImageButton\r\n            android:id=\"@+id/btnBloodTest\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:background=\"@android:color/transparent\"\r\n            android:src=\"@drawable/ic_touch_app_white_48dp\"\r\n            android:contentDescription=\"Калибровка\" />\r\n\r\n        <ImageButton\r\n            android:id=\"@+id/btnCarbs\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:background=\"@android:color/transparent\"\r\n            android:src=\"@drawable/ic_local_dining_white_48dp\"\r\n            android:contentDescription=\"Углеводы\" />\r\n    </LinearLayout>\r\n\r\n    <!-- Данные лечения -->\r\n    <LinearLayout\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:orientation=\"horizontal\"\r\n        android:padding=\"8dp\">\r\n\r\n        <TextView\r\n            android:id=\"@+id/textBloodGlucose\"\r\n            android:layout_width=\"0dp\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_weight=\"1\"\r\n            android:text=\"-- мг/дл\"\r\n            android:textColor=\"@android:color/holo_green_light\"\r\n            android:textSize=\"22sp\"\r\n            android:textStyle=\"bold\" />\r\n\r\n        <TextView\r\n            android:id=\"@+id/textCarbohydrate\"\r\n            android:layout_width=\"0dp\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_weight=\"1\"\r\n            android:text=\"-- грамм\"\r\n            android:textColor=\"@android:color/holo_green_light\"\r\n            android:textSize=\"22dp\"\r\n            android:textStyle=\"bold\" />\r\n\r\n        <TextView\r\n            android:id=\"@+id/textInsulinSumUnits\"\r\n            android:layout_width=\"0dp\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_weight=\"1\"\r\n            android:text=\"-- ед.\"\r\n            android:textColor=\"@android:color/holo_green_light\"\r\n            android:textSize=\"22dp\"\r\n            android:textStyle=\"bold\" />\r\n    </LinearLayout>\r\n\r\n    <!-- Кнопки управления сенсором -->\r\n    <LinearLayout\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:orientation=\"horizontal\"\r\n        android:gravity=\"center\"\r\n        android:padding=\"8dp\">\r\n\r\n        <Button\r\n            android:id=\"@+id/btnStartMonitoring\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:text=\"Старт\"\r\n            android:drawableTop=\"@drawable/ic_heart_pulse_grey600_24dp\" />\r\n\r\n        <Button\r\n            android:id=\"@+id/btnStopMonitoring\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:text=\"Стоп\"\r\n            android:drawableTop=\"@drawable/ic_walk_grey600_24dp\" />\r\n    </LinearLayout>\r\n\r\n    <!-- Nano статус -->\r\n    <LinearLayout\r\n        android:id=\"@+id/nanoStatus\"\r\n        android:layout_width=\"wrap_content\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:orientation=\"horizontal\"\r\n        android:layout_gravity=\"center_horizontal\"\r\n        android:visibility=\"gone\">\r\n\r\n        <TextView\r\n            android:id=\"@+id/nanoStatusText\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_marginStart=\"5dp\"\r\n            android:layout_marginTop=\"2dp\"\r\n            android:text=\"Nano Status\" />\r\n\r\n        <TextView\r\n            android:id=\"@+id/ExpireStatusText\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_marginStart=\"5dp\"\r\n            android:layout_marginTop=\"2dp\"\r\n            android:layout_marginEnd=\"5dp\"\r\n            android:text=\"Expiry Status\" />\r\n    </LinearLayout>\r\n\r\n</LinearLayout>\r\n\r\n<!-- Navigation Drawer -->\r\n<com.google.android.material.navigation.NavigationView\r\n    android:id=\"@+id/nav_view\"\r\n    android:layout_width=\"wrap_content\"\r\n    android:layout_height=\"match_parent\"\r\n    android:layout_gravity=\"start\"\r\n    app:menu=\"@menu/drawer_menu\" />\r\n\r\n</androidx.drawerlayout.widget.DrawerLayout>\r\n</androidx.constraintlayout.widget.ConstraintLayout>
