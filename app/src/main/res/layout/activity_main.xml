<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <!-- Контент -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Текущее значение глюкозы"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"
            android:textColor="@color/accent_color"/>

        <TextView
            android:id="@+id/glucoseValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--.-"
            android:textSize="64sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:textColor="@color/accent_color"/>

        <TextView
            android:id="@+id/glucoseMgdlText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--- mg/dL"
            android:textSize="16sp"
            android:textColor="@color/accent_color"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/timestampText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last update: --:--:--"
            android:textSize="14sp"
            android:textColor="#999999"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Waiting for data..."
            android:textSize="14sp"
            android:textColor="@color/accent_color"/>

    </LinearLayout>

    <!-- Нижнее меню -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/accent_color"
        app:itemTextColor="@color/accent_color" />

</androidx.constraintlayout.widget.ConstraintLayout>