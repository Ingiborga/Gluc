<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name=".ui.LoginFragment"
        android:label="Вход" >
        <action
            android:id="@+id/action_login_to_connect"
            app:destination="@id/connectFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/connectFragment"
        android:name=".ui.ConnectFragment"
        android:label="Подключение" >
        <action
            android:id="@+id/action_connect_to_main"
            app:destination="@id/mainActivity"
            app:popUpTo="@id/connectFragment"
            app:popUpToInclusive="true" />
    </fragment>

    
</navigation>