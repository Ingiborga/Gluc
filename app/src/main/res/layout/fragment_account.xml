<?xml version="1.0" encoding="utf-8"?>
<<androidx.drawerlayout.widget.DrawerLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/drawer_layout"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#212121">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize" />

    <!-- График глюкозы (как в xDrip) -->
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <!-- Текущее значение крупным шрифтом -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/currentBgValueRealTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--.-"
            android:textSize="50sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <ImageView
            android:id="@+id/trendArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="18dp"
            android:src="@drawable/ic_arrow_forward_color_24dp" />
    </LinearLayout>

    <!-- Статусная строка -->
    <TextView
        android:id="@+id/extraStatusLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Статус сенсора"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:shadowColor="#ff212121"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="14" />

    <!-- Прогноз низкого сахара -->
    <TextView
        android:id="@+id/lowpredict"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="30dp"
        android:text="Прогноз: стабильно"
        android:textColor="#C30909"
        android:textStyle="bold"
        android:shadowColor="#ff212121"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="14" />

    <!-- Панель быстрых действий -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnTreatment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_eyedropper_variant_grey600_24dp"
            android:contentDescription="Лечение" />

        <ImageButton
            android:id="@+id/btnNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_note_plus_grey600_24dp"
            android:contentDescription="Заметка" />

        <ImageButton
            android:id="@+id/btnBloodTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_touch_app_white_48dp"
            android:contentDescription="Калибровка" />

        <ImageButton
            android:id="@+id/btnCarbs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_local_dining_white_48dp"
            android:contentDescription="Углеводы" />
    </LinearLayout>

    <!-- Данные лечения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/textBloodGlucose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-- мг/дл"
            android:textColor="@android:color/holo_green_light"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCarbohydrate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-- грамм"
            android:textColor="@android:color/holo_green_light"
            android:textSize="22dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textInsulinSumUnits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-- ед."
            android:textColor="@android:color/holo_green_light"
            android:textSize="22dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Кнопки управления сенсором -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <Button
            android:id="@+id/btnStartMonitoring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Старт"
            android:drawableTop="@drawable/ic_heart_pulse_grey600_24dp" />

        <Button
            android:id="@+id/btnStopMonitoring"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Стоп"
            android:drawableTop="@drawable/ic_walk_grey600_24dp" />
    </LinearLayout>

    <!-- Nano статус -->
    <LinearLayout
        android:id="@+id/nanoStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/nanoStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="2dp"
            android:text="Nano Status" />

        <TextView
            android:id="@+id/ExpireStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="5dp"
            android:text="Expiry Status" />
    </LinearLayout>

</LinearLayout>

<!-- Navigation Drawer -->
<com.google.android.material.navigation.NavigationView
    android:id="@+id/nav_view"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>